{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": true,
    "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
    "model": "opencode/big-pickle",
    "permission": {
        "external_directory" : "allow",
        "doom_loop": "deny",
        "read": {
            "*": "allow",
            "*.env": "allow",
            "*.env.*": "allow",
            "*.env.example": "allow"
        }
    }
}